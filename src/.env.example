# たびメイトの設定ひな型。
#
#   cp src/.env.example src/.env
#
# としてから、自分の値に書き換えてください。src/.env は Git に含まれません。
# 本番（Cloud Run）では deploy.sh がここの値を Secret Manager と環境変数へ流します。

# ── 必須 ────────────────────────────────────────────────────────────
# Flask のセッション署名鍵。本番では未設定だと起動しません。
# 変えると発行済みのログインとアプリ用トークンがすべて無効になります。
SECRET_KEY=

# Gemini（プラン生成・付箋づくり）
GOOGLE_API_KEY=

# Tavily（Web検索）
TAVILY_API_KEY=

# Google OAuth（Web版のログイン）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# データベース（MySQL 8.0 / TiDB / ローカルDocker）
DB_USER=root
DB_PASS=
DB_NAME=travel_db
DB_HOST=127.0.0.1
DB_PORT=3306

# ── iOSアプリを使うなら ─────────────────────────────────────────────
# Google Cloud コンソールで作った iOS 用クライアントID。
# 無いときは GOOGLE_CLIENT_ID を使いますが、どちらも空だとアプリの
# サインインを断ります（宛先が未設定だと aud の検証が省かれてしまうため）。
GOOGLE_IOS_CLIENT_ID=

# アプリ用トークンの有効期間（秒）。既定は30日。
# APP_TOKEN_MAX_AGE_SEC=2592000

# ── 任意 ────────────────────────────────────────────────────────────
# 水彩の地図タイル。未設定なら通常のOSMタイルになります。
# ⚠️ 仕組み上ブラウザに出るので、Stadia 側で必ずドメイン制限をかけてください。
STADIA_API_KEY=

# Google Places を使った座標解決。未設定なら無料スタック
# （Nominatim + 国土地理院）だけで動きます。
# GCPでは「アプリケーション制限＝なしかIP」「Places API (New) に限定」を。
GOOGLE_MAPS_API_KEY=

# TiDB Cloud など TLS 必須の接続で使います。
# DB_SSL=true
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Cloud SQL Connector 経由で繋ぐとき（例: project:region:instance）
# CLOUD_SQL_INSTANCE=

# 写真の保存先。設定すると GCS、無ければローカルのファイルシステム。
# GCS_BUCKET=
# LOCAL_UPLOAD_DIR=uploads
# SIGNED_URL_TTL_SECONDS=3600
# GCS_SIGNER_SA=

# 生成中の状態をインスタンス間で共有する（未設定ならプロセス内のメモリ）
# REDIS_URL=

# 使うモデルの上書き。新しいモデルで問題が出たとき1行で戻せます。
# GEMINI_MODEL_STRONG=gemini-3.6-flash
# GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# 付箋づくりに使う画像の枚数と、送る前のリサイズ上限
# STICKER_MAX_IMAGES=12
# INTERPRETER_IMAGE_MAX_EDGE=1024
